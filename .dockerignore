# Keep the Docker build context limited to production backend and admin sources.
*
!Dockerfile
!docs/
docs/*
!docs/deploy/
docs/deploy/*
!docs/deploy/gin-vue-admin-entrypoint.sh
!docs/deploy/nginx-catlink.conf
!server-gin/
!server-gin/**
!admin-web/
!admin-web/package.json
!admin-web/package-lock.json
!admin-web/index.html
!admin-web/vite.config.js
!admin-web/src/
!admin-web/src/**
server-gin/gva-server.exe
server-gin/*.exe*
server-gin/*.log
server-gin/config.yaml
server-gin/local-data/
server-gin/.tmp/
server-gin/log/
server-gin/uploads/
admin-web/node_modules/
admin-web/dist/
