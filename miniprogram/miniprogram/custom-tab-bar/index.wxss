.tabbar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 50;
  padding: 12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(250, 247, 245, 0), #faf7f5 24%);
}
.tabbar__notice {
  position: fixed;
  z-index: 2;
  display: flex;
  width: 76rpx;
  height: 76rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #753c4d;
  border-radius: 50%;
  background: #8b4a5d;
  box-shadow: 0 10rpx 24rpx rgba(92, 49, 63, 0.18);
  color: #fff8fa;
}
.tabbar__notice--dragging { opacity: 0.84; box-shadow: 0 16rpx 32rpx rgba(92, 49, 63, 0.25); }
.tabbar__notice:active { transform: scale(0.92); }
.tabbar__notice-icon { width: 34rpx; height: 34rpx; }
.tabbar__notice-badge { position: absolute; top: -4rpx; right: -4rpx; width: 18rpx; height: 18rpx; border: 3rpx solid #faf7f5; border-radius: 50%; background: #cc5a58; }
.tabbar__rail {
  display: flex;
  height: 112rpx;
  padding: 8rpx;
  box-sizing: border-box;
  align-items: stretch;
  border: 1rpx solid #e7dfdc;
  border-radius: 56rpx;
  background: #fffdfc;
  box-shadow: 0 12rpx 36rpx rgba(72, 50, 58, 0.08);
}
.tabbar__item {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  border-radius: 44rpx;
  color: #756c70;
}
.tabbar__item--active { color: #8b4a5d; background: #f4e6e9; }
.tabbar__icon { width: 42rpx; height: 42rpx; }
.tabbar__label { font-size: 22rpx; line-height: 30rpx; }
