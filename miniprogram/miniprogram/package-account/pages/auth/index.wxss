.auth-page { gap: 34rpx; }
.wechat-auth { display: flex; flex-direction: column; gap: 24rpx; }
.wechat-submit { display: flex; height: 92rpx; align-items: center; justify-content: center; border-radius: 24rpx; background: #2aae67; color: #fff; font-size: 28rpx; font-weight: 650; }
.auth-divider { display: flex; align-items: center; gap: 18rpx; color: #918789; font-size: 21rpx; }
.auth-divider view { height: 1rpx; flex: 1; background: #e9e1de; }
.auth-tabs { display: flex; padding: 6rpx; gap: 6rpx; border: 1rpx solid #e9e1de; border-radius: 22rpx; background: #f3eeeb; }
.auth-tab { display: flex; height: 68rpx; min-width: 0; flex: 1; align-items: center; justify-content: center; border-radius: 17rpx; color: #766d70; font-size: 24rpx; font-weight: 600; }
.auth-tab--active { background: #fffdfc; color: #7f4355; box-shadow: 0 3rpx 10rpx rgba(81, 55, 64, 0.07); }
.auth-card { overflow: hidden; border: 1rpx solid #e9e1de; border-radius: 24rpx; background: #fffdfc; }
.auth-field { display: flex; min-height: 122rpx; padding: 20rpx 24rpx; flex-direction: column; justify-content: center; gap: 8rpx; border-bottom: 1rpx solid #efe8e5; }
.auth-field:last-child { border-bottom: 0; }
.auth-field__head, .captcha-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.auth-field__label { color: #554b4e; font-size: 24rpx; font-weight: 650; }
.auth-field__sub { color: #8b4a5d; font-size: 22rpx; }
.auth-field__hint { color: #8a8184; font-size: 21rpx; }
.auth-field input { width: 100%; height: 44rpx; color: #342d30; font-size: 27rpx; }
.captcha-row input { min-width: 0; flex: 1; }
.captcha-image { display: flex; width: 190rpx; height: 64rpx; flex: none; align-items: center; justify-content: center; overflow: hidden; border: 1rpx solid #ded3d0; border-radius: 12rpx; background: #faf7f5; color: #8b4a5d; font-size: 21rpx; }
.captcha-image image { width: 100%; height: 100%; }
.auth-submit { display: flex; height: 92rpx; align-items: center; justify-content: center; border-radius: 24rpx; background: #8b4a5d; color: #fff9fa; font-size: 28rpx; font-weight: 650; }
.auth-submit--loading { opacity: 0.56; pointer-events: none; }
.auth-submit:active, .wechat-submit:active, .auth-tab:active, .captcha-image:active { opacity: 0.72; }
