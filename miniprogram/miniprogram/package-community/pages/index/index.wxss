.publish-page { gap: 32rpx; }
.publish-section, .publish-form { display: flex; flex-direction: column; gap: 18rpx; }
.publish-section__label, .publish-field__label { color: #5b5053; font-size: 25rpx; font-weight: 600; }
.publish-topics { display: flex; gap: 12rpx; }
.publish-topic { display: flex; min-width: 112rpx; height: 62rpx; padding: 0 22rpx; align-items: center; justify-content: center; border: 1rpx solid #e3d9d6; border-radius: 31rpx; background: #fffdfc; color: #756c70; font-size: 23rpx; font-weight: 550; }
.publish-topic--active { border-color: #8b4a5d; background: #f3e5e8; color: #7f4355; }
.publish-form { gap: 22rpx; }
.publish-field { display: flex; flex-direction: column; gap: 12rpx; }
.publish-field__heading { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.publish-field__count, .publish-field__optional { color: #93888b; font-size: 21rpx; font-weight: 400; }
.publish-field input, .publish-field textarea { width: 100%; min-height: 88rpx; padding: 0 24rpx; border: 1rpx solid #e3d9d6; border-radius: 24rpx; background: #fffdfc; color: #3a3235; font-size: 27rpx; line-height: 1.5; }
.publish-field--body textarea { min-height: 248rpx; padding-top: 20rpx; padding-bottom: 20rpx; }
.publish-images { display: flex; flex-wrap: wrap; gap: 12rpx; }
.publish-image, .publish-image-add { position: relative; display: flex; width: 150rpx; height: 150rpx; flex: none; align-items: center; justify-content: center; overflow: hidden; border: 1rpx solid #e3d9d6; border-radius: 14rpx; background: #fffdfc; }
.publish-image image { width: 100%; height: 100%; }
.publish-image__remove { position: absolute; top: 6rpx; right: 6rpx; display: flex; width: 40rpx; height: 40rpx; align-items: center; justify-content: center; border-radius: 20rpx; background: rgba(63, 51, 55, 0.68); color: #fff; font-size: 28rpx; line-height: 1; }
.publish-image-add { flex-direction: column; gap: 4rpx; color: #83787b; font-size: 20rpx; }
.publish-image-add__mark { color: #8b4a5d; font-size: 36rpx; line-height: 1; }
.publish-submit-area { display: flex; padding-top: 12rpx; }
.publish-submit { display: flex; width: 100%; min-height: 88rpx; align-items: center; justify-content: center; border-radius: 44rpx; background: #8b4a5d; color: #fff8fa; font-size: 27rpx; font-weight: 600; }
.publish-submit--disabled { background: #d8c7ca; color: #f9f2f3; }
.publish-control--pressed { opacity: 0.72; transform: scale(0.985); }
