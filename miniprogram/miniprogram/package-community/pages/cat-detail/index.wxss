.cat-detail-page { gap: 30rpx; }
.cat-detail-lead { gap: 4rpx; }
.cat-detail__hero { display: flex; overflow: hidden; flex-direction: column; border: 1rpx solid #e9e1de; border-radius: 20rpx; background: #fffdfc; }
.cat-detail__cover { width: 100%; height: 390rpx; background: #f0e9e6; }
.cat-detail__cover--fallback { display: flex; align-items: center; justify-content: center; }
.cat-detail__cover--fallback image { width: 138rpx; height: 138rpx; opacity: 0.72; }
.cat-detail__headline { display: flex; padding: 24rpx 24rpx 18rpx; flex-direction: column; gap: 5rpx; }
.cat-detail__name-wrap { display: flex; min-width: 0; align-items: center; gap: 12rpx; }
.cat-detail__name { overflow: hidden; flex: 1; color: #403639; font-size: 37rpx; font-weight: 650; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }
.cat-detail__status { display: flex; height: 40rpx; padding: 0 12rpx; flex: none; align-items: center; border-radius: 9rpx; background: #f3e5e8; color: #7f4355; font-size: 20rpx; font-weight: 600; white-space: nowrap; }
.cat-detail__location, .cat-detail__owner { color: #83787b; font-size: 22rpx; line-height: 1.45; }
.cat-detail__follow { display: flex; height: 70rpx; margin: 0 24rpx 24rpx; align-items: center; justify-content: center; gap: 12rpx; border: 1rpx solid #d9ccca; border-radius: 14rpx; color: #7f4355; font-size: 24rpx; font-weight: 650; }
.cat-detail__follow--active { border-color: #8b4a5d; background: #f3e5e8; }
.cat-detail__follow--pending { opacity: 0.55; pointer-events: none; }
.cat-detail__follow:active { opacity: 0.72; transform: scale(0.99); }
.cat-detail__section { display: flex; flex-direction: column; gap: 14rpx; }
.cat-detail__section-head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.cat-detail__section-title { color: #4c4245; font-size: 28rpx; font-weight: 650; }
.cat-detail__story { color: #6f6568; font-size: 25rpx; line-height: 1.7; white-space: pre-wrap; }
.cat-detail__updated, .cat-detail__timeline-count { color: #958a8d; font-size: 21rpx; }
.cat-detail__facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); overflow: hidden; border: 1rpx solid #e9e1de; border-radius: 18rpx; background: #fffdfc; }
.cat-detail__fact { display: flex; min-width: 0; min-height: 102rpx; padding: 18rpx 20rpx; flex-direction: column; justify-content: center; gap: 4rpx; border-bottom: 1rpx solid #f0e9e6; }
.cat-detail__fact:nth-last-child(-n+2) { border-bottom: 0; }
.cat-detail__fact:nth-child(odd) { border-right: 1rpx solid #f0e9e6; }
.cat-detail__fact-label { color: #93888b; font-size: 20rpx; }
.cat-detail__fact-value { overflow: hidden; color: #4a4043; font-size: 24rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.cat-detail__photos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8rpx; }
.cat-detail__photo { width: 100%; height: 190rpx; border-radius: 12rpx; background: #f0e9e6; }
.cat-detail__timeline { display: flex; padding: 4rpx 0 0; flex-direction: column; }
.cat-detail__timeline-item { position: relative; display: flex; min-height: 102rpx; gap: 18rpx; }
.cat-detail__timeline-item:not(:last-child)::before { position: absolute; top: 24rpx; bottom: -2rpx; left: 8rpx; width: 2rpx; background: #e7dbd9; content: ''; }
.cat-detail__timeline-mark { width: 18rpx; height: 18rpx; margin-top: 8rpx; flex: none; border: 4rpx solid #f4e2e7; border-radius: 50%; background: #8b4a5d; z-index: 1; }
.cat-detail__timeline-body { display: flex; min-width: 0; padding-bottom: 20rpx; flex: 1; flex-direction: column; gap: 4rpx; }
.cat-detail__timeline-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.cat-detail__timeline-kind { color: #4f4448; font-size: 24rpx; font-weight: 650; }
.cat-detail__timeline-date { flex: none; color: #968b8e; font-size: 20rpx; }
.cat-detail__timeline-text { color: #756b6e; font-size: 23rpx; line-height: 1.6; white-space: pre-wrap; }
.cat-detail__timeline-empty { padding: 28rpx 0; color: #93888b; font-size: 24rpx; text-align: center; }
.detail-loading { display: flex; min-height: 410rpx; align-items: center; justify-content: center; flex-direction: column; gap: 16rpx; color: #8b8185; font-size: 24rpx; }
.detail-loading image { width: 96rpx; height: 96rpx; opacity: 0.76; }
.detail-empty { min-height: 360rpx; }
.detail-empty__logo { width: 112rpx; height: 112rpx; opacity: 0.74; }
.detail-empty__action { min-width: 220rpx; margin-top: 10rpx; }
