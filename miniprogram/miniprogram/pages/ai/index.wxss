.ai-page { gap: 28rpx; }
.ai-page--chat { height: 100vh; padding-bottom: calc(250rpx + env(safe-area-inset-bottom)); overflow: hidden; }
.ai-page--chat .ai-hero__logo { width: 72rpx; height: 72rpx; }
.ai-page--chat .page__title { font-size: 40rpx; }
.ai-page--chat .page__summary { font-size: 23rpx; line-height: 1.45; }
.ai-mode-row { display: flex; padding: 5rpx; gap: 4rpx; border-radius: 34rpx; background: #f0ece9; }
.ai-mode { display: flex; height: 58rpx; flex: 1; align-items: center; justify-content: center; border-radius: 29rpx; color: #81777a; font-size: 23rpx; font-weight: 600; }
.ai-mode--active { background: #fffdfc; color: #7f4355; box-shadow: 0 3rpx 10rpx rgba(81,55,64,.06); }
.ai-hero { display: flex; align-items: center; gap: 18rpx; }
.ai-hero__logo { width: 92rpx; height: 92rpx; flex: none; border: 1rpx solid #eadfdd; border-radius: 14rpx; background: #fffdfc; }
.ai-step-row { display: flex; min-height: 64rpx; padding: 5rpx; align-items: stretch; gap: 4rpx; border: 1rpx solid #e8dfdc; border-radius: 16rpx; background: #f5f1ef; }
.ai-step { display: flex; min-width: 0; flex: 1; align-items: center; justify-content: center; gap: 7rpx; color: #92878a; font-size: 19rpx; font-weight: 550; white-space: nowrap; }
.ai-step text:first-child { color: #b2a6a8; font-size: 18rpx; }
.ai-step--active { border-radius: 11rpx; background: #fffdfc; color: #7f4355; box-shadow: 0 3rpx 10rpx rgba(81, 55, 64, 0.05); }
.ai-step--active text:first-child { color: #8b4a5d; }

.ai-input-section { display: flex; padding: 22rpx; flex-direction: column; gap: 16rpx; border: 1rpx solid #e9e1de; border-radius: 18rpx; background: #fffdfc; }
.ai-section-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.ai-section-heading > view { display: flex; min-width: 0; flex-direction: column; gap: 4rpx; }
.ai-section-heading__title, .ai-prompts__title { color: #4f4448; font-size: 27rpx; font-weight: 650; }
.ai-section-heading__hint { color: #8b8185; font-size: 21rpx; line-height: 1.45; }
.ai-section-heading__count { flex: none; color: #9b9093; font-size: 20rpx; white-space: nowrap; }
.ai-description { width: 100%; min-height: 244rpx; padding: 16rpx; border: 1rpx solid #e6dcda; border-radius: 12rpx; background: #fdfbfa; color: #42383b; font-size: 26rpx; line-height: 1.6; }

.ai-prompts { display: flex; flex-direction: column; gap: 14rpx; }
.ai-prompt-scroll { width: calc(100% + 44rpx); margin: 0 -22rpx; padding: 0 22rpx 6rpx; white-space: nowrap; }
.ai-prompt { display: inline-flex; width: 270rpx; min-height: 96rpx; margin-right: 10rpx; padding: 16rpx; vertical-align: top; flex-direction: column; justify-content: center; gap: 4rpx; border: 1rpx solid #e7dfdc; border-radius: 18rpx; background: #fffdfc; white-space: normal; }
.ai-prompt:nth-child(2) { background: #f8efea; border-color: #efdfd4; }
.ai-prompt:nth-child(3) { background: #eef4f1; border-color: #dbe9e3; }
.ai-prompt__title { color: #55494c; font-size: 25rpx; font-weight: 650; line-height: 1.25; }
.ai-prompt__body { color: #84797c; font-size: 20rpx; line-height: 1.4; }
.ai-prompt--pressed, .ai-generate--pressed { opacity: 0.72; transform: scale(0.985); }

.ai-generate, .ai-apply { display: flex; min-height: 86rpx; padding: 0 26rpx; align-items: center; justify-content: space-between; border-radius: 16rpx; background: #8b4a5d; color: #fff8fa; font-size: 27rpx; font-weight: 650; }
.ai-generate--disabled { background: #cdb8bd; }
.ai-generate__arrow { font-size: 34rpx; font-weight: 400; }
.ai-error { padding: 15rpx 18rpx; border-left: 5rpx solid #c66b61; background: #fdf3f0; color: #9d5149; font-size: 22rpx; line-height: 1.55; }

.ai-result { display: flex; padding: 24rpx; flex-direction: column; gap: 20rpx; border: 1rpx solid #ddded4; border-radius: 18rpx; background: #fbfcf9; }
.ai-result__head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.ai-result__head > view:first-child { display: flex; flex-direction: column; gap: 4rpx; }
.ai-result__eyebrow { color: #5b7b70; font-size: 18rpx; font-weight: 650; }
.ai-result__title { color: #3f4d48; font-size: 30rpx; font-weight: 650; }
.ai-result__clear { min-height: 50rpx; padding: 0 10rpx; color: #7b6f72; font-size: 21rpx; }
.ai-result__fields { display: flex; flex-direction: column; border-top: 1rpx solid #e4e8e3; }
.ai-result__field { display: flex; padding: 15rpx 0; align-items: flex-start; gap: 18rpx; border-bottom: 1rpx solid #e4e8e3; }
.ai-result__label { width: 148rpx; flex: none; color: #7c8b86; font-size: 21rpx; }
.ai-result__value { min-width: 0; flex: 1; color: #454d49; font-size: 24rpx; line-height: 1.55; word-break: break-all; }
.ai-apply { background: #416a61; }
.ai-chat { display: flex; min-height: 0; flex: 1; flex-direction: column; gap: 12rpx; }
.ai-chat-toolbar { position: relative; display: flex; align-items: center; gap: 10rpx; }
.ai-session-trigger { display: flex; height: 58rpx; min-width: 0; padding: 0 18rpx; flex: 1; align-items: center; justify-content: space-between; gap: 10rpx; border-radius: 29rpx; background: #f0ece9; color: #675d60; font-size: 22rpx; }
.ai-session-trigger text:first-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ai-new-session { display: flex; height: 58rpx; padding: 0 18rpx; flex: none; align-items: center; border-radius: 29rpx; background: #8b4a5d; color: #fff8fa; font-size: 22rpx; font-weight: 600; }
.ai-new-session--disabled { opacity: .42; }
.ai-session-menu { position: absolute; top: 66rpx; left: 0; z-index: 8; display: flex; width: calc(100% - 132rpx); max-height: 320rpx; padding: 8rpx; overflow-y: auto; flex-direction: column; gap: 4rpx; border: 1rpx solid #e3d9d6; border-radius: 18rpx; background: #fffdfc; box-shadow: 0 12rpx 28rpx rgba(81,55,64,.12); }
.ai-session-item { display: flex; min-height: 52rpx; padding: 8rpx 8rpx 8rpx 16rpx; align-items: center; gap: 8rpx; border-radius: 12rpx; color: #756c70; font-size: 21rpx; }
.ai-session-item > text { overflow: hidden; min-width: 0; flex: 1; text-overflow: ellipsis; white-space: nowrap; }
.ai-session-item--active { background: #f3e5e8; color: #7f4355; font-weight: 600; }
.ai-session-delete { display: flex; width: 40rpx; height: 40rpx; flex: none; align-items: center; justify-content: center; border-radius: 20rpx; color: #9a8f92; font-size: 28rpx; font-weight: 400; }
.ai-message-list { height: calc(100vh - 430rpx - env(safe-area-inset-bottom)); min-height: 300rpx; }
.ai-chat-empty { display: flex; min-height: 360rpx; align-items: center; justify-content: center; flex-direction: column; gap: 8rpx; color: #81777a; font-size: 22rpx; text-align: center; }
.ai-chat-empty image { width: 96rpx; height: 96rpx; margin-bottom: 8rpx; opacity: .7; }
.ai-chat-empty text:last-child { color: #9a8f92; font-size: 20rpx; }
.ai-message { display: flex; padding: 6rpx 0; }
.ai-message--user { justify-content: flex-end; }
.ai-message--assistant { justify-content: flex-start; }
.ai-message__bubble { max-width: 78%; padding: 18rpx 20rpx; border-radius: 22rpx 22rpx 22rpx 6rpx; background: #fffdfc; color: #4b4144; font-size: 24rpx; line-height: 1.6; word-break: break-all; }
.ai-message--user .ai-message__bubble { border-radius: 22rpx 22rpx 6rpx 22rpx; background: #8b4a5d; color: #fff8fa; }
.ai-message__typing { color: #81777a; }
.ai-chat-composer { position: fixed; right: 24rpx; bottom: calc(148rpx + env(safe-area-inset-bottom)); left: 24rpx; z-index: 40; display: flex; min-height: 92rpx; padding: 10rpx 10rpx 10rpx 20rpx; align-items: flex-end; gap: 10rpx; border: 1rpx solid #e2d8d5; border-radius: 32rpx; background: #fffdfc; box-shadow: 0 10rpx 28rpx rgba(72,50,58,.1); }
.ai-chat-input { min-height: 68rpx; max-height: 176rpx; padding: 14rpx 0; flex: 1; color: #3f3739; font-size: 25rpx; line-height: 1.5; }
.ai-send { display: flex; width: 72rpx; height: 72rpx; flex: none; align-items: center; justify-content: center; border-radius: 50%; background: #8b4a5d; }
.ai-send image { width: 34rpx; height: 34rpx; }
.ai-send--disabled { background: #cdb8bd; opacity: 1; }
@media (min-width: 520px) { .ai-chat-composer { width: 702rpx; right: auto; left: 50%; transform: translateX(-50%); } }
