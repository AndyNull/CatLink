# Copy to .env on the server. Never commit the real .env file.
COMPOSE_PROJECT_NAME=catlink
CATLINK_BIND_ADDRESS=0.0.0.0
CATLINK_WEB_PORT=58888
CATLINK_FRONTEND_SUBNET=172.30.88.0/24

# Existing 1Panel MySQL. Use host.docker.internal when its port is published to the host,
# or the MySQL container name together with docs/deploy/docker-compose.onepanel-network.yml.
CATLINK_DB_HOST=host.docker.internal
CATLINK_DB_PORT=3306
CATLINK_DB_NAME=gva
CATLINK_DB_USER=catlink
CATLINK_DB_PASSWORD=

# Existing 1Panel Redis. Leave password empty only when that Redis instance has no password.
CATLINK_USE_REDIS=true
CATLINK_REDIS_ADDR=host.docker.internal:6379
CATLINK_REDIS_PASSWORD=
# Required only for the shared-container-network deployment mode.
CATLINK_1PANEL_NETWORK=

# At least 32 random characters. Keep unchanged across restarts.
CATLINK_JWT_SIGNING_KEY=

# Set only on the first empty-database boot, then clear after login.
CATLINK_BOOTSTRAP_ADMIN_PASSWORD=

# false lets Gin create/update tables through GORM AutoMigrate.
CATLINK_DISABLE_AUTO_MIGRATE=false

# Optional initial provider. Local is used on first boot; all nine providers can be configured and switched in the admin plugin.
CATLINK_OSS_TYPE=local
CATLINK_MINIO_ENDPOINT=
CATLINK_MINIO_ACCESS_KEY=
CATLINK_MINIO_SECRET_KEY=
CATLINK_MINIO_BUCKET=
CATLINK_MINIO_USE_SSL=true
CATLINK_MINIO_BASE_URL=
CATLINK_S3_BUCKET=
CATLINK_S3_REGION=
CATLINK_S3_ENDPOINT=
CATLINK_S3_ACCESS_KEY=
CATLINK_S3_SECRET_KEY=
CATLINK_S3_BASE_URL=
CATLINK_S3_PATH_PREFIX=catlink
CATLINK_S3_FORCE_PATH_STYLE=false
CATLINK_S3_DISABLE_SSL=false

# Storage plugin secret references use env://VARIABLE_NAME in the admin UI.
CATLINK_QINIU_ACCESS_KEY=
CATLINK_QINIU_SECRET_KEY=
CATLINK_ENCOURAGEMENT_AI_KEY=
CATLINK_SMTP_PASSWORD=
CATLINK_TENCENT_SECRET_ID=
CATLINK_TENCENT_SECRET_KEY=
CATLINK_ALIYUN_ACCESS_KEY_ID=
CATLINK_ALIYUN_ACCESS_KEY_SECRET=
CATLINK_HUAWEI_ACCESS_KEY=
CATLINK_HUAWEI_SECRET_KEY=
CATLINK_R2_ACCOUNT_ID=
CATLINK_R2_ACCESS_KEY_ID=
CATLINK_R2_SECRET_ACCESS_KEY=
CATLINK_WEBDAV_PASSWORD=

# HTTPS reverse-geocoding endpoint. Keep configurable without rebuilding the App.
CATLINK_GEOCODER_URL=https://nominatim.openstreetmap.org/reverse
# Optional HTTPS endpoint template returning JSON city/district fields. `{ip}` is replaced server-side.
CATLINK_IP_GEO_ENDPOINT=
# Enable only when the reverse proxy strips client values and injects X-Geo-City/X-Geo-District itself.
CATLINK_TRUST_IP_GEO_HEADERS=false
# Comma-separated reverse-proxy IPs/CIDRs trusted for X-Forwarded-For and Geo headers.
# Keep the CatLink frontend subnet and append the exact 1Panel proxy subnet when needed.
CATLINK_TRUSTED_PROXY_CIDRS=172.30.88.0/24
